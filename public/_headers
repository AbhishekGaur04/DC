# Cache rules for static hosting (Netlify, Cloudflare Pages, etc.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/projects/*.webp
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache
